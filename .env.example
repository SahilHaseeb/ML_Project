# Pakistan AI Job Market Intelligence Platform
# Environment variable template — copy this to .env and fill in your values
# NEVER commit your actual .env file to Git

# ─── PostgreSQL (optional — app works without it using CSV) ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pakistan_jobs
DB_USER=your_username
DB_PASSWORD=your_password

# ─── Application settings ─────────────────────────────────────────────────────
APP_ENV=development       # development | production
LOG_LEVEL=INFO

# ─── Future: API keys for data sources ───────────────────────────────────────
# ROZEE_API_KEY=
# LINKEDIN_API_KEY=
